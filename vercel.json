{
  "version": 2,
  "name": "namyang-pets-web",
  "cleanUrls": true,
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=3600, must-revalidate"
        }
      ]
    }
  ],
  "routes": [
    {
      "src": "/pet",
      "dest": "/pet.html"
    },
    {
      "src": "/(.*)",
      "dest": "/$1"
    }
  ]
}
